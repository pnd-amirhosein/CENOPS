@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NTSW_CENOPS.Components.Common.Notices.AppNoticeService Notices

<div class="source-graph" @ref="_container" dir="rtl">
    <GraphWorkspace StageClass="source-graph-stage"
                    StageLabel="نمودار وابستگی نمادها؛ Ctrl و اسکرول برای بزرگ‌نمایی"
                    ShowPathTools="true" PathToolsEnabled="@(_selectedIds.Count == 2)" FocusToolsEnabled="@(_selectedIds.Count == 1)" ShowFullscreenNotices="true"
                    OnReset="ResetAsync" OnZoomIn="ZoomInAsync" OnZoomOut="ZoomOutAsync"
                    OnHighlightPath="HighlightPathAsync" OnFocusBranch="FocusBranchAsync"
                    OnFullscreen="FullscreenAsync">
        <StageContent>
            <svg class="source-graph-svg" aria-label="نمودار ارتباط نمادها"><g class="source-graph-viewport"></g></svg>
            <div class="source-graph-tooltip" aria-hidden="true"></div>
        </StageContent>
        <InspectorContent>
    @if (_selected is not null)
    {
        <aside class="source-graph-selection" aria-label="اطلاعات گره انتخاب‌شده" aria-live="polite">
            <div class="source-graph-selection-header">
                <span class="source-graph-selection-kind">@_selected.Kind</span>
                <button type="button" aria-label="بستن جزئیات" @onclick="ClearSelection" title="بستن">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
                </button>
            </div>
            <strong dir="ltr" class="source-graph-selection-name">@_selected.Title</strong>
            @if (NodeNotices.TryGetValue(_selected.Id, out var graphNotice))
            {
                <p class="source-graph-node-notice" role="status">@graphNotice</p>
            }
            @if (_selected.ReferenceCount > 0)
            {
                <span class="source-graph-selection-count">@_selected.ReferenceCount reference(s) in this declaration</span>
            }
            @if (_selected.Relationship.Contains("MediatR", StringComparison.Ordinal))
            {
                <span class="source-graph-framework-tag" title="ارتباط از نوع dispatch؛ با قرارداد MediatR و نوع درخواست از سورس استنتاج شده است، نه فراخوانی مستقیم C#">MediatR · inferred dispatch</span>
            }
            <div class="source-graph-selection-metadata">
                @if (!string.IsNullOrWhiteSpace(_selected.Project)) { <span>Project</span><b dir="ltr">@_selected.Project</b> }
                @if (!string.IsNullOrWhiteSpace(_selected.File)) { <span>File</span><b dir="ltr">@_selected.File:@_selected.Line</b> }
                <span>Namespace</span><b dir="ltr">@(!string.IsNullOrWhiteSpace(_selected.Namespace) ? _selected.Namespace : "—")</b>
            </div>
            @if (!string.IsNullOrWhiteSpace(_selected.Code))
            {
                <SourceCodePreview Code="@_selected.Code" />
            }
            @if (_selected.Line > 0 && _selected.Kind != "Definition" && OnOpenDetails.HasDelegate)
            {
                <button type="button" class="source-graph-details-action" @onclick="OpenSelectedDetailsAsync">مشاهده کد مرتبط و کل فایل</button>
            }
        </aside>
    }
        </InspectorContent>
        <LegendContent>Ctrl + Wheel · Zoom <span>│</span> Wheel · Vertical <span>│</span> Shift + Wheel · Horizontal <span>│</span> Ctrl + Click · Multi-select <span>│</span> Shift + Tool · Isolate <span>│</span> Dashed · MediatR</LegendContent>
        <ModalContent>@ModalContent</ModalContent>
    </GraphWorkspace>
</div>

@code {
    [Parameter] public IReadOnlyList<SourceGraphNode> Nodes { get; set; } = Array.Empty<SourceGraphNode>();
    [Parameter] public IReadOnlyList<SourceGraphEdge> Edges { get; set; } = Array.Empty<SourceGraphEdge>();
    [Parameter] public EventCallback<SourceGraphNode> OnOpenDetails { get; set; }
    [Parameter] public EventCallback<SourceGraphNode> OnExpandNode { get; set; }
    [Parameter] public EventCallback<string> OnCollapseNode { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string> NodeNotices { get; set; } =
        new Dictionary<string, string>();
    [Parameter] public RenderFragment? ModalContent { get; set; }

    private SourceGraphNode? _selected;
    private readonly List<string> _selectedIds = [];
    private ElementReference _container;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SourceGraphView>? _self;
    private bool _renderNeeded = true;
    private IReadOnlyList<SourceGraphNode>? _previousNodes;
    private IReadOnlyList<SourceGraphEdge>? _previousEdges;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Nodes, _previousNodes) && ReferenceEquals(Edges, _previousEdges)) return;
        _previousNodes = Nodes;
        _previousEdges = Edges;
        if (_selected is not null)
            _selected = Nodes.FirstOrDefault(n => n.Id == _selected.Id);
        _renderNeeded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_renderNeeded) return;
        _renderNeeded = false;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/source-relation-graph.js?v=2.51");
        _self ??= DotNetObjectReference.Create(this);
        if (firstRender) await _module.InvokeVoidAsync("mount", _container, Nodes, Edges, _self);
        else await _module.InvokeVoidAsync("update", _container, Nodes, Edges);
    }

    [JSInvokable]
    public async Task CollapseNode(string id)
    {
        if (OnCollapseNode.HasDelegate) await OnCollapseNode.InvokeAsync(id);
    }

    [JSInvokable]
    public async Task<bool> ExpandNode(string id)
    {
        var node = Nodes.FirstOrDefault(n => n.Id == id);
        if (node is null || string.IsNullOrWhiteSpace(node.ExpandSymbolId) || !OnExpandNode.HasDelegate)
            return false;
        _selected = node;
        await OnExpandNode.InvokeAsync(node);
        await InvokeAsync(StateHasChanged);
        return true;
    }

    [JSInvokable]
    public Task SelectNode(string id)
    {
        _selected = Nodes.FirstOrDefault(node => node.Id == id);
        return InvokeAsync(StateHasChanged);
    }

    private async Task ClearSelection()
    {
        _selected = null;
        _selectedIds.Clear();
        if (_module is not null) await _module.InvokeVoidAsync("clearSelection", _container);
    }

    [JSInvokable] public Task SelectionChanged(string[] ids)
    {
        _selectedIds.Clear();
        _selectedIds.AddRange(ids);
        if (ids.Length == 0) _selected = null;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable] public Task DismissDetails()
    {
        _selected = null;
        _selectedIds.Clear();
        return InvokeAsync(StateHasChanged);
    }

    private async Task OpenSelectedDetailsAsync()
    {
        if (_selected is null || !OnOpenDetails.HasDelegate) return;
        // The viewer is rendered inside the fullscreen graph via ModalContent.
        // Do not exit fullscreen; that would disrupt the exploration context.
        await OnOpenDetails.InvokeAsync(_selected);
    }

    private async Task ResetAsync() { if (_module is not null) await _module.InvokeVoidAsync("reset", _container); }
    private async Task ZoomInAsync() { if (_module is not null) await _module.InvokeVoidAsync("zoom", _container, 1.2); }
    private async Task ZoomOutAsync() { if (_module is not null) await _module.InvokeVoidAsync("zoom", _container, 1 / 1.2); }
    private async Task FullscreenAsync() { if (_module is not null) await _module.InvokeVoidAsync("fullscreen", _container); }
    private async Task HighlightPathAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        if (_module is null || _selectedIds.Count != 2) return;
        var found = await _module.InvokeAsync<bool>("highlightPath", _container, args.ShiftKey);
        if (!found) Notices.Error("بین دو گره انتخاب‌شده در نمودار فعلی مسیری پیدا نشد.");
    }
    private async Task FocusBranchAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        if (_module is not null && _selectedIds.Count == 1)
            await _module.InvokeVoidAsync("focusBranch", _container, args.ShiftKey);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("unmount", _container); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
