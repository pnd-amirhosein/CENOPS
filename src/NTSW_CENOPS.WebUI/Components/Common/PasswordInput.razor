<div class="password-input-shell">
    <input id="@Id"
           name="@Name"
           type="@InputType"
           autocomplete="@Autocomplete"
           placeholder="@Placeholder"
           minlength="@MinLength"
           required="@Required"
           class="@CssClass" />

    <button type="button"
            class="password-visibility-button"
            aria-label="@VisibilityAriaLabel"
            title="@VisibilityAriaLabel"
            @onclick="ToggleVisibility">
        @if (_isVisible)
        {
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3 3L21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                <path d="M10.6 10.7C10.22 11.08 10 11.6 10 12.15C10 13.25 10.9 14.15 12 14.15C12.55 14.15 13.05 13.93 13.42 13.58" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                <path d="M6.3 6.55C4.7 7.65 3.45 9.2 2.75 11.05C2.5 11.7 2.5 12.3 2.75 12.95C4.15 16.65 7.7 19.15 12 19.15C13.65 19.15 15.2 18.78 16.55 18.1M9.4 5.15C10.22 4.95 11.1 4.85 12 4.85C16.3 4.85 19.85 7.35 21.25 11.05C21.5 11.7 21.5 12.3 21.25 12.95C20.85 14 20.27 14.95 19.55 15.75" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M2.75 11.05C4.15 7.35 7.7 4.85 12 4.85C16.3 4.85 19.85 7.35 21.25 11.05C21.5 11.7 21.5 12.3 21.25 12.95C19.85 16.65 16.3 19.15 12 19.15C7.7 19.15 4.15 16.65 2.75 12.95C2.5 12.3 2.5 11.7 2.75 11.05Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="12" cy="12" r="2.35" stroke="currentColor" stroke-width="1.6" />
            </svg>
        }
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "رمز عبور";

    [Parameter]
    public string Autocomplete { get; set; } = "current-password";

    [Parameter]
    public int? MinLength { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public string CssClass { get; set; } = "w-full";

    private bool _isVisible;

    private string InputType => _isVisible ? "text" : "password";

    private string VisibilityAriaLabel => _isVisible ? "پنهان کردن رمز عبور" : "نمایش رمز عبور";

    private void ToggleVisibility() => _isVisible = !_isVisible;
}
