@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="app-nested-menu @CssClass" @ref="_element" dir="rtl">
    <button type="button" class="app-nested-menu-trigger" aria-label="@TriggerLabel"
            title="@TriggerLabel" aria-haspopup="menu" aria-expanded="@_open" @onclick="Toggle">
        @TriggerContent
    </button>
    @if (_open)
    {
        <div class="app-nested-menu-popover cenops-liquid-glass @(_expanded is null ? "" : "drawer-open")" role="group" aria-label="@MenuLabel">
            <div class="app-nested-menu-primary" role="menu" aria-label="@MenuLabel">
                @foreach (var item in Items)
                {
                    <button @key="item.Value" type="button" role="menuitem" disabled="@item.Disabled"
                            class="app-nested-menu-item @(_expanded == item.Value ? "active" : "")"
                            aria-haspopup="@(item.Children is { Count: > 0 } ? "menu" : null)"
                            aria-expanded="@(item.Children is { Count: > 0 } ? _expanded == item.Value : null)"
                            @onclick="() => SelectAsync(item)">
                        <span class="app-nested-menu-item-label">@item.Label</span>
                        @if (item.Count is int count) { <span class="app-nested-menu-count" aria-label="@($"{count} مورد انتخاب‌شده")">@count</span> }
                        @if (!string.IsNullOrWhiteSpace(item.Hint)) { <small>@item.Hint</small> }
                        @if (item.Children is { Count: > 0 })
                        {
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
                        }
                    </button>
                }
            </div>
            <div class="app-nested-menu-drawer" aria-hidden="@(_expanded is null)">
                @if (_expanded is not null)
                {
                    var parent = Items.FirstOrDefault(x => x.Value == _expanded);
                    @if (parent?.Children is { Count: > 0 } children)
                    {
                        <div class="app-nested-menu-submenu" role="menu" aria-label="@parent.Label">
                            @foreach (var item in children)
                            {
                                <button @key="item.Value" type="button" role="menuitem" disabled="@item.Disabled"
                                        data-menu-value="@item.Value" class="app-nested-menu-item"
                                        @onclick="() => SelectAsync(item)">
                                    <span class="app-nested-menu-item-label">@item.Label</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Hint)) { <small>@item.Hint</small> }
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment TriggerContent { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<AppNestedMenuItem> Items { get; set; } = [];
    [Parameter] public string TriggerLabel { get; set; } = "نمایش منو";
    [Parameter] public string MenuLabel { get; set; } = "انتخاب عملیات";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public EventCallback<string> OnSelected { get; set; }
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AppNestedMenu>? _self;
    private bool _open;
    private string? _expanded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-nested-menu.js?v=2.57");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _element, _self);
        }
        if (_open && _module is not null)
            await _module.InvokeVoidAsync("place", _element);
    }
    private void Toggle() { _open = !_open; _expanded = null; }
    private async Task SelectAsync(AppNestedMenuItem item)
    {
        if (item.Disabled) return;
        if (item.Children is { Count: > 0 }) { _expanded = _expanded == item.Value ? null : item.Value; return; }
        _open = false; _expanded = null;
        await OnSelected.InvokeAsync(item.Value);
    }
    [JSInvokable] public Task Dismiss()
    {
        if (!_open) return Task.CompletedTask;
        _open = false; _expanded = null;
        return InvokeAsync(StateHasChanged);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detach", _element); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
