@using NTSW_CENOPS.Components.Common.Dates
<div class="jalali-picker" dir="rtl">
    <button type="button" class="jalali-trigger" disabled="@Disabled" aria-label="@AriaLabel"
            aria-haspopup="dialog" aria-expanded="@_open" @onclick="Toggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18"/></svg>
        <span class="@(!Value.HasValue ? "jalali-placeholder" : "")">@(Value is { } d ? JalaliDate.Date(d) : Placeholder)</span>
    </button>
    @if (_open)
    {
        <button type="button" class="jalali-backdrop" aria-label="بستن تقویم" @onclick="Close"></button>
        <div class="jalali-popover" role="dialog" aria-label="@AriaLabel">
            <div class="jalali-heading">
                <button type="button" title="ماه قبل" aria-label="ماه قبل" @onclick="PreviousMonth">›</button>
                <div class="jalali-month-year">
                    <select aria-label="ماه شمسی" value="@_month" @onchange="SetMonth">
                        @for (var month = 1; month <= 12; month++)
                        { <option value="@month">@JalaliDate.Month(month)</option> }
                    </select>
                    <select aria-label="سال شمسی" value="@_year" @onchange="SetYear">
                        @for (var year = MaxPersianYear; year >= MinPersianYear; year--)
                        { <option value="@year">@year</option> }
                    </select>
                </div>
                <button type="button" title="ماه بعد" aria-label="ماه بعد" @onclick="NextMonth">‹</button>
            </div>
            <div class="jalali-weekdays">
                @foreach (var name in Weekdays) { <span>@name</span> }
            </div>
            <div class="jalali-days">
                @for (var blank = 0; blank < StartOffset; blank++)
                { <span aria-hidden="true"></span> }
                @for (var day = 1; day <= Days; day++)
                {
                    var currentDay = day;
                    var date = JalaliDate.Gregorian(_year, _month, day);
                    <button type="button" disabled="@(!IsAllowed(date))"
                            class="@(Value?.Date == date.Date ? "is-selected" : "")" aria-label="@JalaliDate.Date(date)"
                            @onclick="() => Pick(currentDay)">@day</button>
                }
            </div>
            <div class="jalali-footer">
                <button type="button" disabled="@(!IsAllowed(DateTime.Today))" @onclick="PickToday">امروز</button>
                @if (AllowClear) { <button type="button" @onclick="Clear">پاک کردن</button> }
            </div>
        </div>
    }
</div>
@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "انتخاب تاریخ شمسی";
    [Parameter] public string Placeholder { get; set; } = "انتخاب تاریخ";
    [Parameter] public DateTime? Min { get; set; }
    [Parameter] public DateTime? Max { get; set; }
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    private static readonly string[] Weekdays = ["ش", "ی", "د", "س", "چ", "پ", "ج"];
    private bool _open;
    private int _year, _month;
    private static int CurrentPersianYear => JalaliDate.Parts(DateTime.Today).Year;
    private int MinPersianYear => Min.HasValue ? JalaliDate.Parts(Min.Value).Year : 1250;
    private int MaxPersianYear => Max.HasValue ? JalaliDate.Parts(Max.Value).Year : CurrentPersianYear + 20;
    private bool IsAllowed(DateTime value) =>
        (!Min.HasValue || value.Date >= Min.Value.Date) && (!Max.HasValue || value.Date <= Max.Value.Date);
    private int Days => JalaliDate.DaysInMonth(_year, _month);
    private int StartOffset => ((int)JalaliDate.Gregorian(_year, _month, 1).DayOfWeek + 1) % 7;
    private void Toggle()
    {
        if (_open) { _open = false; return; }
        var date = Value ?? DateTime.Today;
        (_year, _month, _) = JalaliDate.Parts(date);
        _open = true;
    }
    private void Close() => _open = false;
    private void PreviousMonth() { if (_year <= MinPersianYear && _month == 1) return; if (--_month < 1) { _month = 12; --_year; } }
    private void NextMonth() { if (_year >= MaxPersianYear && _month == 12) return; if (++_month > 12) { _month = 1; ++_year; } }
    private void SetYear(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var year) && year >= MinPersianYear && year <= MaxPersianYear) _year = year;
    }
    private void SetMonth(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var month) && month is >= 1 and <= 12) _month = month;
    }
    private async Task Pick(int day)
    {
        var date = JalaliDate.Gregorian(_year, _month, day);
        if (!IsAllowed(date)) return;
        _open = false;
        await ValueChanged.InvokeAsync(date);
    }
    private async Task PickToday()
    {
        if (!IsAllowed(DateTime.Today)) return;
        _open = false;
        await ValueChanged.InvokeAsync(DateTime.Today);
    }
    private async Task Clear()
    {
        _open = false;
        await ValueChanged.InvokeAsync(null);
    }
}
