@using System.Security.Claims
@using Microsoft.JSInterop
@using NTSW_CENOPS.Application.Dashboards
@inject IDashboardContentService Catalog
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="dash-smart-config-backdrop" @onclick="Cancel" dir="rtl">
    <section class="dash-smart-config-modal" role="dialog" aria-modal="true" aria-labelledby="smart-config-title" @onclick:stopPropagation="true">
        <button class="dash-smart-escape-trigger" type="button" data-smart-escape-action @onclick="EscapeAsync" tabindex="-1" aria-hidden="true"></button>
        <header><div><small>داشبورد / کارت هوشمند</small><h2 id="smart-config-title">تنظیم کارت هوشمند</h2></div>
            <button class="dash-smart-close modal-esc-key" type="button" title="بستن (Esc)" aria-label="بستن پنجره تنظیمات" @onclick="EscapeAsync">ESC</button></header>
        <div class="dash-smart-config-main">
            <p>محتوای موردنظر را انتخاب کنید و ترتیب نمایش آن‌ها را تغییر دهید.</p>
            <button type="button" class="dash-button dash-primary" @onclick="() => _browserOpen = true">+ انتخاب محتوا (@_selected.Count)</button>
            <div class="dash-smart-sort-list" @ref="_sortRoot" aria-label="اولویت کارت‌های انتخابی">
                @if (_loading) { <AppLoading IsLoading="true" Variant="inline" Label="در حال آماده‌سازی انتخاب‌ها..." /> }
                else if (_selected.Count == 0) { <p class="dash-smart-config-empty">محتوایی انتخاب نشده است.</p> }
                @foreach (var item in _selected)
                {
                    <div @key="(item.Type,item.Id)" class="dash-smart-sort-row" data-note-block="@Key(item)">
                        <span class="dash-smart-grip" title="برای جابه‌جایی بکشید" draggable="true" data-note-drag="@Key(item)" aria-label="دستگیره جابه‌جایی">
                            <svg viewBox="0 0 20 20" fill="currentColor"><circle cx="7" cy="4" r="1.5"/><circle cx="13" cy="4" r="1.5"/><circle cx="7" cy="10" r="1.5"/><circle cx="13" cy="10" r="1.5"/><circle cx="7" cy="16" r="1.5"/><circle cx="13" cy="16" r="1.5"/></svg>
                        </span><strong title="@item.Title">@item.Title</strong>
                        <span class="dash-smart-type">@TypeLabel(item.Type)</span>
                        <button type="button" class="dash-smart-row-delete" title="حذف از انتخاب" aria-label="حذف @item.Title" @onclick="() => Remove(item)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5m4-5v5"/></svg>
                        </button>
                    </div>
                }
            </div>
            <div class="dash-smart-config-options">
                <div class="dash-smart-setting"><strong>جهت نمایش</strong>
                    <label class="dash-smart-switch"><input type="checkbox" @bind="_horizontal"/><span class="dash-smart-switch-track"></span><span>@(_horizontal ? "افقی" : "عمودی")</span></label>
                </div>
                <label class="dash-smart-setting"><strong>زمان نمایش (ثانیه)</strong><input type="number" min="1" max="3600" step="1" @bind="_seconds" /></label>
            </div>
            @if (_error is not null) { <p class="dash-smart-config-error" role="alert">@_error</p> }
        </div>
        <footer><button class="dash-button" @onclick="Cancel">انصراف</button><button class="dash-button dash-primary" disabled="@(_loading || _saving)" @onclick="SaveAsync">ذخیره تنظیمات</button></footer>
    </section>
    @if (_browserOpen)
    {
        <div class="dash-smart-browser-backdrop" @onclick:stopPropagation="true">
            <section class="dash-smart-browser-modal dcp-modal" role="dialog" aria-modal="true" aria-label="انتخاب محتوای کارت هوشمند">
                <header class="dcp-header"><div><h2>کتابخانه محتوا</h2><p>محتوای موردنظر کارت هوشمند را انتخاب کنید.</p></div>
                    <button type="button" class="dcp-close modal-esc-key" @onclick="() => _browserOpen = false" aria-label="بستن کتابخانه">ESC</button></header>
                <DashboardContentBrowser Actor="Actor" Selected="_selected" PublicOnly="Global" AllowSmart="false"
                    OnToggle="Toggle" OnPreview="ShowPreview" />
                <footer class="dcp-footer"><span>@_selected.Count مورد انتخاب شده</span><button class="dcp-btn dcp-personal-add" @onclick="() => _browserOpen = false">تأیید انتخاب‌ها</button></footer>
                @if (_preview is not null)
                { <DashboardContentPreview Item="_preview" Actor="Actor" OnClose="() => _preview = null" /> }
            </section>
        </div>
    }
</div>
@code {
    [Parameter, EditorRequired] public ClaimsPrincipal Actor { get; set; } = default!;
    [Parameter, EditorRequired] public DashboardContentReference Layout { get; set; } = default!;
    [Parameter] public bool Global { get; set; }
    [Parameter] public EventCallback<DashboardCardOptions> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private readonly List<DashboardContentItem> _selected = [];
    private bool _loading = true, _browserOpen, _horizontal = true, _saving;
    private int _seconds = 3;
    private string? _error;
    private ElementReference _sortRoot;
    private DotNetObjectReference<DashboardSmartConfigModal>? _dragBridge;
    private bool _attached;
    private DashboardContentItem? _preview;
    private static string Key(DashboardContentItem item) => $"{item.Type}:{item.Id}";
    private static string TypeLabel(string type) => type switch
    {
        "note" => "یادداشت", "announcement" => "اطلاعیه", "todo" => "کارها",
        "sql" => "SQL", "curl" => "cURL", "report" => "گزارش",
        "events-day" => "روزانه", "events-week" => "هفتگی", "events-month" => "ماهانه", _ => type
    };
    protected override async Task OnInitializedAsync()
    {
        var settings = Layout.Options ?? new DashboardCardOptions();
        _horizontal = settings.Horizontal;
        _seconds = settings.IntervalSeconds;
        if (settings.Items is { Count: > 0 })
        {
            try { _selected.AddRange(await Catalog.ResolveAsync(settings.Items, Global, Actor)); }
            catch (Exception) { _error = "برخی محتواهای ذخیره‌شده در دسترس نیستند."; }
        }
        _loading = false;
    }
    private Task Toggle(DashboardContentItem item)
    {
        if (!DashboardSpecialCards.IsEmbeddable(item.Type) || (Global && !item.IsPublic)) return Task.CompletedTask;
        var index = _selected.FindIndex(x => Key(x) == Key(item));
        if (index >= 0) _selected.RemoveAt(index);
        else if (_selected.Count < 30) _selected.Add(item);
        else _error = "حداکثر ۳۰ کارت در کارت هوشمند مجاز است.";
        return Task.CompletedTask;
    }
    private Task ShowPreview(DashboardContentItem item) { _preview = item; return Task.CompletedTask; }
    private void Remove(DashboardContentItem item) => _selected.RemoveAll(x => Key(x) == Key(item));
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _attached) return;
        _dragBridge ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("cenopsNoteDrag.attach", _sortRoot, _dragBridge);
            _attached = true;
        }
        catch (JSDisconnectedException) { }
    }
    [JSInvokable]
    public async Task MoveBlockAsync(string sourceKey, string targetKey, bool insertAfter)
    {
        var from = _selected.FindIndex(x => Key(x) == sourceKey);
        var to = _selected.FindIndex(x => Key(x) == targetKey);
        if (from < 0 || to < 0 || from == to) return;
        var moved = _selected[from];
        _selected.RemoveAt(from);
        var at = to + (insertAfter ? 1 : 0);
        if (from < at) at--;
        _selected.Insert(Math.Clamp(at, 0, _selected.Count), moved);
        await InvokeAsync(StateHasChanged);
    }
    public async ValueTask DisposeAsync()
    {
        try { if (_attached) await JS.InvokeVoidAsync("cenopsNoteDrag.detach", _sortRoot); }
        catch (JSDisconnectedException) { }
        _dragBridge?.Dispose();
    }
    private Task EscapeAsync()
    {
        if (_preview is not null) { _preview = null; return Task.CompletedTask; }
        if (_browserOpen) { _browserOpen = false; return Task.CompletedTask; }
        return Cancel();
    }
    private Task Cancel() => OnCancel.InvokeAsync();
    private async Task SaveAsync()
    {
        if (_saving) return;
        if (_seconds is < 1 or > 3600) { _error = "بازه زمانی باید بین ۱ تا ۳۶۰۰ ثانیه باشد."; return; }
        _saving = true;
        try
        {
            var refs = _selected.Select(x => new DashboardContentReference(x.Type, x.Id)).ToArray();
            await OnSave.InvokeAsync(new DashboardCardOptions(Items: refs, Horizontal: _horizontal, IntervalSeconds: _seconds));
        }
        finally { _saving = false; }
    }
}
