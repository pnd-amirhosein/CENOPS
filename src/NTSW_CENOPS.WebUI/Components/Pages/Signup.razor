@page "/signup"
@using NTSW_CENOPS.Components.Layout
@using Microsoft.AspNetCore.Authorization
@using NTSW_CENOPS.Components.Common
@layout EmptyLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>ثبت نام</PageTitle>

<div class="auth-stage h-screen w-full flex items-center justify-center">
    <div class="login-container auth-card flex gap-4 h-50 w-50">
        <AuthBrandPanel />
        <div class="login-box auth-form-panel flex flex-col justify-content-between gap-8 w-1/2 rtl pl-4">
            <div class="welcome text-xl">
                ایجاد حساب در
                <AnimatedTitle/>
            </div>
            <form method="post" action="/auth/signup" class="login-main flex flex-col gap-3">
                <AntiforgeryToken />

                <div>
                    <input name="displayName"
                           autocomplete="name"
                           placeholder="نام نمایشی"
                           maxlength="150"
                           required
                           class="w-full"
                           value="@DisplayName" />
                </div>

                <div>
                    <input name="username"
                           autocomplete="username"
                           placeholder="نام کاربری"
                           maxlength="100"
                           required
                           class="w-full"
                           value="@Username" />
                </div>

                <div>
                    <PasswordInput Name="password"
                                   Autocomplete="new-password"
                                   Placeholder="رمز عبور"
                                   MinLength="8"
                                   Required="true" />
                    <div class="password-hint text-xs text-gray-500 mt-1">
                        حداقل ۸ کاراکتر، شامل حرف بزرگ، حرف کوچک و عدد
                    </div>
                </div>

                <div>
                    <PasswordInput Name="confirmPassword"
                                   Autocomplete="new-password"
                                   Placeholder="تکرار رمز عبور"
                                   MinLength="8"
                                   Required="true" />
                </div>

                <div class="button-container flex justify-content-between items-center">
                    @if (!string.IsNullOrEmpty(Error))
                    {
                        <p class="text-red-500 text-sm text-center" role="alert">@Error</p>
                    }
                    <button type="submit" class="w-1/3">
                        <div class="text">ثبت نام</div>
                    </button>
                </div>
            </form>
            <div class="help text-normal text-primary flex items-center gap-2">
                <span>حساب کاربری دارید؟</span>
                <a href="/" class="auth-link">بازگشت به ورود</a>
            </div>
            <div class="credit text-xs text-gray-500 flex flex-col gap-2">
                <span>تولید توسعه و پشتیبانی:</span>
                <span>تیم مدیریت اطلاعات و فناوری سامانه جامع تجارت واحد گمرک </span>
            </div>
        </div>
    </div>
</div>