@using NTSW_CENOPS.Components.Notes
@using NTSW_CENOPS.Application.Dashboards
@using NTSW_CENOPS.Application.Reports
@using System.Security.Claims

<div class="dashboard-tile @Item.Type @(_editingClass)" data-dash-tile="@(Item.Type + ":" + Item.Id)"
     data-dash-w="@Layout.Width" data-dash-h="@Layout.Height"
     data-dash-x="@Layout.X" data-dash-y="@Layout.Y"
     data-dash-pw="@Layout.PixelWidth" data-dash-ph="@Layout.PixelHeight"
     data-dash-cw="@Layout.CanvasWidth">
    @if (Editable)
    {
        <div class="dash-tile-tools">
            <button class="dash-drag" data-dash-drag="@(Item.Type + ":" + Item.Id)" type="button" aria-label="جابجایی @Item.Title" title="بکشید: وسط کارت برای جابه‌جایی، لبه یا فضای خالی برای انتقال">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="8" cy="5" r="1.7"/><circle cx="16" cy="5" r="1.7"/><circle cx="8" cy="12" r="1.7"/><circle cx="16" cy="12" r="1.7"/><circle cx="8" cy="19" r="1.7"/><circle cx="16" cy="19" r="1.7"/></svg>
            </button>
            <button class="dash-delete" type="button" title="حذف از داشبورد" aria-label="حذف @Item.Title از داشبورد" @onclick="() => OnRemove.InvokeAsync(Item)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 4h4M6.5 7l1 13h9l1-13M10 11v5M14 11v5"/></svg>
            </button>
        </div>
    }
    @if (Item.IsRestricted)
    {
        <div class="dash-restricted" role="status" aria-label="محتوای غیرقابل دسترس">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            <strong>دسترسی به این محتوا ندارید</strong>
            <small>این کارت خصوصی است یا دیگر در دسترس نیست.</small>
        </div>
    }
    else if (Item.Type == "smart" && Actor is not null)
    {
        @if (Editable)
        { <button class="dash-smart-configure" type="button" @onclick="() => OnConfigure.InvokeAsync(Item)">⚙ تنظیمات کارت</button> }
        <DashboardSmartCard Layout="Layout" Actor="Actor" Global="Global" Charts="Charts" OnPreview="OnPreview" OnEventDetails="OnEventDetails" />
    }
    else if (Item.Type is "event" or "events-day" or "events-week" or "events-month" && Actor is not null)
    {
        <DashboardEventCard Item="Item" Layout="Layout" Actor="Actor" Editable="Editable" OnEventChanged="OnEventChanged" OnDetailsRequested="OnEventDetails" />
    }
    else if (Item.Type == "announcement")
    {
        <div class="dash-announcement">
            <div class="dash-announcement-meta"><span>اطلاعیه - <UserHoverName DisplayName="@Item.Author" /></span></div>
            <h3 dir="auto">@Item.Title</h3>
        </div>
    }
    else if (Item.Type == "report")
    {
        <div class="dash-chart">
            @if (Chart is not null)
            { <MonitoringReportChart Data="Chart" DashboardMode="true" /> }
            else
            { <p class="dash-chart-unavailable">دریافت نمودار در حال حاضر ممکن نیست.</p> }
        </div>
    }
    else
    {
        <div class="dash-card-topline">
            <span class="dash-card-byline">@Label(Item.Type) - <UserHoverName DisplayName="@Item.Author" /></span>
            <button type="button" class="dash-card-preview" @onclick="() => OnPreview.InvokeAsync(Item)">مشاهده محتوا <span aria-hidden="true">↗</span></button>
        </div>
        <div class="dash-card-heading"><h3 title="@Item.Title">@Item.Title</h3></div>
        @if (Item.Type == "todo")
        {
            <div class="dash-tasks">
                @if (Item.TodoItems is { Count: > 0 })
                {
                    @foreach (var task in Item.TodoItems.Take(3))
                    {
                        <div class="dash-task @(task.IsCompleted ? "is-done" : "")"><span class="dash-check" aria-hidden="true">@if (task.IsCompleted) { <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8 3.1 3.1 5.9-6"/></svg> }</span><span title="@task.Text" dir="auto">@task.Text</span></div>
                    }
                }
                else { <p>هنوز کاری ثبت نشده است.</p> }
            </div>
        }
        else if (Item.Type == "note" && Item.NoteBlocks is { Count: > 0 })
        {
            <div class="dash-note-content"><NoteContent Blocks="Item.NoteBlocks" /></div>
        }
        else if (Item.Type is "sql" or "curl")
        {
            <p class="dash-description">@Item.Summary</p>
            <pre class="dash-snippet" dir="ltr">@Item.CodePreview</pre>
        }
        else { <p class="dash-description">@Item.Summary</p> }
        @* Author and preview now share the top row; keep the content area entirely flexible. *@
    }
    @if (Editable)
    {
        <button class="dash-size-handle x" type="button" data-dash-resize="x" title="تغییر عرض از سمت چپ" aria-label="تغییر عرض @Item.Title"></button>
        <button class="dash-size-handle y" type="button" data-dash-resize="y" title="تغییر ارتفاع از پایین" aria-label="تغییر ارتفاع @Item.Title"></button>
        <button class="dash-size-handle xy" type="button" data-dash-resize="xy" title="تغییر عرض و ارتفاع" aria-label="تغییر ابعاد @Item.Title"></button>
    }
</div>

@code {
    [Parameter, EditorRequired] public DashboardContentItem Item { get; set; } = default!;
    [Parameter, EditorRequired] public DashboardContentReference Layout { get; set; } = default!;
    [Parameter] public MonitoringChartData? Chart { get; set; }
    [Parameter] public IReadOnlyDictionary<long, MonitoringChartData>? Charts { get; set; }
    [Parameter] public ClaimsPrincipal? Actor { get; set; }
    [Parameter] public bool Global { get; set; }
    [Parameter] public EventCallback<DashboardContentItem> OnConfigure { get; set; }
    [Parameter] public EventCallback<int?> OnEventChanged { get; set; }
    [Parameter] public EventCallback<NTSW_CENOPS.Application.Events.CalendarOccurrence> OnEventDetails { get; set; }
    [Parameter] public bool Editable { get; set; }
    [Parameter] public EventCallback<DashboardContentItem> OnRemove { get; set; }
    [Parameter] public EventCallback<DashboardContentItem> OnPreview { get; set; }
    private string _editingClass => Editable ? "editing" : "";
    private static string Label(string type) => type switch
    {
        "note" => "یادداشت", "todo" => "کارها", "sql" => "SQL", "curl" => "cURL", "report" => "گزارش", _ => type
    };
}
