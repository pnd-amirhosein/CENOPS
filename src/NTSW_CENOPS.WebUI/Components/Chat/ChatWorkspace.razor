@using NTSW_CENOPS.Components.Common.Dates
@using System.Security.Claims
@using NTSW_CENOPS.Application.Chat
@using NTSW_CENOPS.Application.Common.Security
@using NTSW_CENOPS.Domain.Chat
@using NTSW_CENOPS.Components.Chat
@using NTSW_CENOPS.Components.Common
@using NTSW_CENOPS.Components.Files
@using NTSW_CENOPS.Application.Files
@implements IAsyncDisposable
@inject ChatWorkspaceState Workspace
@inject IChatRoomService Rooms
@inject IChatMessageService Messages
@inject IChatSearchService Search
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS
@inject ChatInboxState Inbox

<div class="cenops-chat-backdrop" @onclick="Workspace.Close" aria-hidden="true"></div>
<section class="cenops-chat-window" dir="ltr" role="dialog" aria-modal="true" aria-label="چت اسپیس">
    <header class="chat-modal-header" dir="rtl">
        <strong class="chat-modal-title">چت اسپیس</strong>
        <div class="chat-modal-connection" role="status" aria-live="polite" aria-atomic="true">
            @if (_connected)
            {
                <span class="chat-connection-connected" @key="_connectionEpoch"><span class="chat-connection-dot"></span> متصل شد</span>
            }
            else
            {
                <span class="chat-connection-connecting"><span class="chat-connection-pulse"></span> در حال اتصال<span class="chat-animated-dots" aria-hidden="true"></span></span>
            }
        </div>
        <button type="button" class="chat-modal-close" title="بستن چت" aria-label="بستن چت" @onclick="Workspace.Close"><span class="modal-esc-key">ESC</span></button>
    </header>
    <div class="chat-columns">
        <aside class="chat-rail" aria-label="راهبر گفتگو">
            <button type="button" class="chat-rail-item is-active" title="گفتگوها" aria-label="گفتگوها" @onclick="CloseSearch"><ChatIcon Name="messages" /></button>
            <button type="button" class="chat-rail-item chat-rail-new" title="گفتگوی تازه (Ctrl+K، سپس N)" aria-label="ایجاد گفتگو" aria-keyshortcuts="Control+K N" @onclick="OpenCreate"><ChatIcon Name="plus" /><kbd class="chat-rail-shortcut" aria-hidden="true">N</kbd></button>
            <div class="chat-rail-spacer"></div>
            <button type="button" class="chat-rail-item chat-rail-search @(_globalSearchOpen ? "is-active" : "")" title="جستجوی سراسری (Ctrl+K، سپس S)" aria-label="جستجوی کاربران، گفتگوها و پیام‌ها" aria-keyshortcuts="Control+K S" @onclick="OpenSearch"><ChatIcon Name="search" /><kbd class="chat-rail-shortcut" aria-hidden="true">S</kbd></button>
            <div class="chat-rail-logo" title="مرکز عملیات"><svg class="chat-brand-logo" width="35" height="35" viewBox="0 0 388 388" fill="none"
                 xmlns="http://www.w3.org/2000/svg">
                <g clip-path="url(#clip0_2002_2)">
                    <rect width="388" height="388" rx="96" fill="#19B5DE"/>
                    <path
                        d="M-17.75 197.75C-15.5833 197.75 -14.1667 199.083 -13.5 201.75C-12.6667 204.417 -12.25 208.583 -12.25 214.25C-12.25 220.417 -12.6667 224.917 -13.5 227.75C-14.1667 230.583 -15.5833 232 -17.75 232H-59C-61.1667 232 -62.5833 230.667 -63.25 228C-64.0833 225.167 -64.5 221 -64.5 215.5C-64.5 209.167 -64.0833 204.667 -63.25 202C-62.5833 199.167 -61.1667 197.75 -59 197.75H-17.75ZM23.5098 197.75C25.6764 197.75 27.0931 199.083 27.7598 201.75C28.5931 204.417 29.0098 208.583 29.0098 214.25C29.0098 220.417 28.5931 224.917 27.7598 227.75C27.0931 230.583 25.6764 232 23.5098 232H-17.7402C-19.9069 232 -21.3236 230.667 -21.9902 228C-22.8236 225.167 -23.2402 221 -23.2402 215.5C-23.2402 209.167 -22.8236 204.667 -21.9902 202C-21.3236 199.167 -19.9069 197.75 -17.7402 197.75H23.5098ZM64.7695 197.75C66.9362 197.75 68.3529 199.083 69.0195 201.75C69.8529 204.417 70.2695 208.583 70.2695 214.25C70.2695 220.417 69.8529 224.917 69.0195 227.75C68.3529 230.583 66.9362 232 64.7695 232H23.5195C21.3529 232 19.9362 230.667 19.2695 228C18.4362 225.167 18.0195 221 18.0195 215.5C18.0195 209.167 18.4362 204.667 19.2695 202C19.9362 199.167 21.3529 197.75 23.5195 197.75H64.7695ZM106.029 197.75C108.196 197.75 109.613 199.083 110.279 201.75C111.113 204.417 111.529 208.583 111.529 214.25C111.529 220.417 111.113 224.917 110.279 227.75C109.613 230.583 108.196 232 106.029 232H64.7793C62.6126 232 61.196 230.667 60.5293 228C59.696 225.167 59.2793 221 59.2793 215.5C59.2793 209.167 59.696 204.667 60.5293 202C61.196 199.167 62.6126 197.75 64.7793 197.75H106.029ZM118.539 197.75C127.706 197.75 132.289 193.083 132.289 183.75V157.75H163.789V183.75C163.789 188.583 165.206 192.167 168.039 194.5C171.039 196.667 174.622 197.75 178.789 197.75C184.289 197.75 188.206 196.667 190.539 194.5C192.872 192.167 194.039 188.583 194.039 183.75V157.75H225.789V183.75C225.789 188.583 226.956 192.167 229.289 194.5C231.789 196.667 234.706 197.75 238.039 197.75C246.206 197.75 250.289 193.083 250.289 183.75V157.75H282.039