@namespace NTSW_CENOPS.Components.Chat
<svg class="chat-ui-icon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "search":
            <circle cx="10.7" cy="10.7" r="6.8"/><path d="m16 16 4.4 4.4"/>
            break;
        case "messages":
            <path d="M20.5 11.6a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-1l-4.5 1.1 1.2-4.2a8.5 8.5 0 1 1 15.8-4.4Z"/><path d="M8 11h8M8 14.5h5"/>
            break;
        case "plus":
            <path d="M12 5v14M5 12h14"/>
            break;
        case "minus":
            <path d="M5 12h14"/>
            break;
        case "x":
            <path d="M6 6l12 12M18 6 6 18"/>
            break;
        case "reply":
            <path d="m9 10-5 4 5 4"/><path d="M5 14h9a6 6 0 0 0 0-12" transform="translate(1 4)"/>
            break;
        case "forward":
            <path d="m15 8 5 4-5 4"/><path d="M19 12H9a6 6 0 0 0-6 6"/>
            break;
        case "edit":
            <path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L9 17l-4 1 1-4Z"/>
            break;
        case "trash":
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>
            break;
        case "hash":
            <path d="M9 3 7 21M17 3l-2 18M4 9h17M3 15h17"/>
            break;
        case "more":
            <circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/>
            break;
        case "info":
            <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
            break;
        case "chevron-down":
            <path d="m6 9 6 6 6-6"/>
            break;
        case "arrow-up-left":
            <path d="M17 17 7 7M7 17V7h10"/>
            break;
        case "attachment":
            <path d="m20 11.5-8.2 8.2a5.5 5.5 0 0 1-7.8-7.8l9.1-9.1a3.8 3.8 0 0 1 5.4 5.4L9.6 17a2.2 2.2 0 0 1-3.1-3.1l8.1-8.1" />
            break;
        case "send":
            <path d="M20 4 9 15m11-11-7 16-4-7-7-4 18-5Z"/>
            break;
        default:
            <circle cx="12" cy="12" r="9"/>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
}
