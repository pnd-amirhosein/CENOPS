@using NTSW_CENOPS.Application.Notes
<div class="note-insert-choices">
    @foreach (var option in Options)
    {
        <button type="button" @onclick="() => OnSelect.InvokeAsync(option.Kind)">
            <span class="note-picker-icon" aria-hidden="true">
                @switch (option.Kind)
                {
                    case NoteBlockKind.Heading:
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M4 5v14M20 5v14M4 12h16"/></svg>
                        break;
                    case NoteBlockKind.Paragraph:
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M5 5h14M5 9h14M5 13h12M5 17h9"/></svg>
                        break;
                    case NoteBlockKind.Code:
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16"/></svg>
                        break;
                    case NoteBlockKind.File:
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10l-7-7v7h7"/><path d="M8 16h8"/></svg>
                        break;
                    case NoteBlockKind.Table:
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M10 4v16M10 15h11"/></svg>
                        break;
                }
            </span>
            <span><strong>@option.Title</strong><small>@option.Description</small></span>
        </button>
    }
</div>
@code {
    [Parameter] public EventCallback<NoteBlockKind> OnSelect { get; set; }
    private static readonly (NoteBlockKind Kind, string Title, string Description)[] Options =
    [
        (NoteBlockKind.Heading, "عنوان فرعی", "تیتر بخش"),
        (NoteBlockKind.Paragraph, "پاراگراف", "متن و توضیحات"),
        (NoteBlockKind.Code, "قطعه کد", "دستور و نمونه کد"),
        (NoteBlockKind.Table, "جدول", "سطر و ستون قابل ویرایش"),
        (NoteBlockKind.File, "فایل", "پیوست و بارگذاری چند فایل")
    ];
}
