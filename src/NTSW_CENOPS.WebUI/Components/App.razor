<body>
<Routes @rendermode="PageRenderMode"/>

@* Blazor Server updates this element's classes when the SignalR circuit changes.
   Kept outside the interactive app shell so it also works during disconnection. *@
<div id="components-reconnect-modal" class="cenops-reconnect" dir="rtl" role="status" aria-live="polite" aria-atomic="true">
    <span class="cenops-reconnect-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.5 9a12 12 0 0 1 15 0M7.5 12.5a7 7 0 0 1 9 0M10.5 16a2.6 2.6 0 0 1 3 0"/>
            <circle cx="12" cy="20" r="1" fill="currentColor" stroke="none"/>
        </svg>
    </span>
    <div class="cenops-reconnect-copy">
        <strong>ارتباط با سرور قطع شده است</strong>
        <p class="cenops-reconnect-connecting">در حال اتصال مجدد؛ لطفاً کمی صبر کنید…</p>
        <p class="cenops-reconnect-failed">اتصال برقرار نشد. اتصال اینترنت را بررسی کنید و دوباره تلاش کنید.</p>
        <p class="cenops-reconnect-rejected">نشست فعلی پایان یافته است. برای ادامه، صفحه را دوباره بارگذاری کنید.</p>
    </div>
    <span class="cenops-reconnect-spinner" aria-hidden="true"></span>
    <button type="button" class="cenops-reconnect-retry" onclick="cenopsUI.retryConnection()">تلاش مجدد</button>
    <button type="button" class="cenops-reconnect-reload" onclick="location.reload()">بارگذاری صفحه</button>
</div>

<script src="js/site.js?v=2.28"></script>
<script src="js/searchable-select.js?v=2.13.1"></script>
<script src="js/chat-realtime.js?v=2.6.0"></script>
<script src="js/note-code.js?v=2.28"></script>
<script src="js/note-drag.js?v=2.30"></script>
<script src="js/file-drop.js?v=2.66"></script>
<script src="js/snippet-draft.js?v=2.26"></script>
<script src="js/wiki-editor-shortcuts.js?v=2.20"></script>
<script src="js/dashboard-grid.js?v=2.20"></script>
<script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // One interactive circuit for layout + page + scoped busy/notice services.
    // Anonymous/password HTTP-form pages remain static so auth endpoints work unchanged.
    private Microsoft.AspNetCore.Components.IComponentRenderMode? PageRenderMode
    {
        get
        {
            var path = HttpContext?.Request.Path.Value ?? string.Empty;
            var isAuthPage = path.Equals("/", StringComparison.OrdinalIgnoreCase)
                || path.Equals("/login", StringComparison.OrdinalIgnoreCase)
                || path.Equals("/signup", StringComparison.OrdinalIgnoreCase)
                || path.Equals("/change-password", StringComparison.OrdinalIgnoreCase);
            return isAuthPage ? null : InteractiveServer;
        }
    }
}
